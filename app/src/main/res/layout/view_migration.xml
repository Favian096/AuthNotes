<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/migration_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/migration_description"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/migration_scan"
        style="@style/Widget.AuthNotes.MigrationAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/migration_scan" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/rule" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/migration_select"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/migration_accounts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/migration_qr_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/migration_qr_image"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/migration_qr_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/migration_qr_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/migration_scan_in_order"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/migration_qr_previous"
                    style="@style/Widget.AuthNotes.MigrationAction"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/migration_previous" />

                <TextView
                    android:id="@+id/migration_qr_next"
                    style="@style/Widget.AuthNotes.MigrationAction"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/migration_next" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/migration_generate"
        style="@style/Widget.AuthNotes.MigrationAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/migration_generate" />
</LinearLayout>
