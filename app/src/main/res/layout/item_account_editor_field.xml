<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/field_drag_handle"
        android:layout_width="30dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="•"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_muted"
        android:contentDescription="@string/editor_field_handle" />
    <EditText
        android:id="@+id/field_name"
        style="@style/Widget.AuthNotes.EditorInput"
        android:layout_height="48dp"
        android:layout_weight="0.37"
        android:hint="@string/editor_field_name"
        android:textSize="18sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=":"
        android:textSize="16sp"
        android:textColor="@color/text_muted" />
    <EditText
        android:id="@+id/field_value"
        style="@style/Widget.AuthNotes.EditorInput"
        android:layout_height="48dp"
        android:layout_weight="0.63"
        android:hint="@string/editor_field_value"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/field_remove"
        style="@style/Widget.AuthNotes.EditorAction"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/editor_remove"
        android:textColor="@color/action_delete"
        android:textSize="13sp" />
</LinearLayout>
