<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">
    <FrameLayout
        android:id="@+id/account_editor_color_slot"
        android:layout_width="match_parent"
        android:layout_height="64dp" />
    <LinearLayout
        android:id="@+id/account_editor_tag_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            style="@style/Widget.AuthNotes.EditorLabel"
            android:text="@string/editor_tag" />
        <EditText
            android:id="@+id/account_editor_tag"
            style="@style/Widget.AuthNotes.EditorInput"
            android:hint="@string/editor_required"
            android:tag="initial-input" />
    </LinearLayout>
    <com.authnotes.ui.ReorderColumn
        android:id="@+id/account_editor_fields"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    <TextView
        android:id="@+id/account_editor_add_field"
        style="@style/Widget.AuthNotes.EditorAction"
        android:text="@string/editor_add_field"
        android:textColor="@color/accent_blue" />
    <LinearLayout
        android:id="@+id/account_editor_remark_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">
        <TextView
            style="@style/Widget.AuthNotes.EditorLabel"
            android:text="@string/editor_remark" />
        <EditText
            android:id="@+id/account_editor_remark"
            style="@style/Widget.AuthNotes.EditorInput"
            android:layout_height="72dp"
            android:singleLine="false"
            android:inputType="textMultiLine"
            android:minLines="2" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:text="@string/editor_attachment_limits"
        android:textColor="@color/text_muted"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/account_editor_add_attachment"
        style="@style/Widget.AuthNotes.EditorAction"
        android:text="@string/editor_add_attachment"
        android:textColor="@color/accent_blue" />
    <LinearLayout
        android:id="@+id/account_editor_attachment_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
